# =============================================================================
# Playwright MCP Server Environment Configuration
# =============================================================================

# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# PostgreSQL Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=playwright_mcp
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# -----------------------------------------------------------------------------
# Server Configuration
# -----------------------------------------------------------------------------

# MCP Server Settings
MCP_SERVER_HOST=localhost
MCP_SERVER_PORT=3000

# -----------------------------------------------------------------------------
# Playwright Browser Configuration
# -----------------------------------------------------------------------------

# Browser Settings
PLAYWRIGHT_BROWSER=chromium
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_SANDBOX=true

# Browser Executable Path (optional)
# PLAYWRIGHT_EXECUTABLE_PATH=

# User Data Directory (optional)
# PLAYWRIGHT_USER_DATA_DIR=

# Viewport Size (format: width,height)
PLAYWRIGHT_VIEWPORT_SIZE=1280,720

# User Agent (optional)
# PLAYWRIGHT_USER_AGENT=

# -----------------------------------------------------------------------------
# Network Configuration
# -----------------------------------------------------------------------------

# Proxy Settings (optional)
# PROXY_SERVER=
# PROXY_BYPASS=

# HTTPS Settings
IGNORE_HTTPS_ERRORS=false

# Service Workers
BLOCK_SERVICE_WORKERS=false

# -----------------------------------------------------------------------------
# Feature Toggles
# -----------------------------------------------------------------------------

# Vision Capabilities
VISION_ENABLED=false

# Token Tracking
TOKEN_TRACKING_ENABLED=false
TOKEN_TRACKING_SHOW_DETAILS=true

# Response Management
MAX_RESPONSE_SIZE=10000
SAVE_RESPONSES_TO_FILES=false
TRUNCATE_LARGE_RESPONSES=true

# Image Response Handling (allow|omit|auto)
IMAGE_RESPONSES=auto

# -----------------------------------------------------------------------------
# Output and Logging
# -----------------------------------------------------------------------------

# Output Directory (optional - defaults to temp directory)
# OUTPUT_DIR=./output

# Trace and Debug Settings
SAVE_TRACE=false
SHOW_TOKENS=false

# -----------------------------------------------------------------------------
# Development Settings
# -----------------------------------------------------------------------------

# Environment
NODE_ENV=development

# Debug Mode
DEBUG=false

# Isolated Browser Context
ISOLATED_CONTEXT=false

# Storage State File (optional)
# STORAGE_STATE_FILE=

# -----------------------------------------------------------------------------
# Docker-specific Settings (used when running in containers)
# -----------------------------------------------------------------------------

# Docker Redis Host (when using docker-compose)
# REDIS_HOST=redis

# Docker PostgreSQL Host (when using docker-compose)
# POSTGRES_HOST=postgres
